{
  "name": "booksmartly-glowlabs",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "description": "BookSmartly backend powered by GlowLabs",
  "main": "backend/app.js",
  "scripts": {
    "start": "node backend/app.js",
    "dev": "nodemon backend/app.js",
    "test": "jest",
    "test:schema": "jest tests/schema.test.js",
    "test:store": "jest Client/src/tests/store.test.js",
    "build": "npm --workspace frontend run build"
  },
  "dependencies": {
    "@google-cloud/pubsub": "^2.18.0",
    "@google-cloud/text-to-speech": "^6.0.1",
    "@google/genai": "^0.10.0",
    "@square/web-sdk": "^2.1.0",
    "apollo-server-express": "^3.13.0",
    "axios": "^1.7.9",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.0",
    "connect-redis": "^9.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "datebook": "^7.1.0",
    "dotenv": "^16.5.0",
    "elevenlabs": "^1.57.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-graphql": "^0.12.0",
    "express-session": "^1.18.1",
    "express-validator": "^7.2.1",
    "fs": "0.0.1-security",
    "generate-password": "^1.6.1",
    "google-tts-api": "^2.0.2",
    "googleapis": "^146.0.0",
    "graphql": "^15.8.0",
    "graphql-playground-middleware-express": "^1.7.23",
    "ioredis": "^5.5.0",
    "jsonwebtoken": "^9.0.2",
    "mjml": "^4.13.0",
    "moment": "^2.29.1",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.10.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "phone": "^3.1.42",
    "process": "^0.11.10",
    "puppeteer": "^24.10.2",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "redux": "^5.0.1",
    "Server": "^1.0.0",
    "socket.io": "^4.8.1",
    "square": "^43.0.0",
    "squareup": "^1.0.0",
    "stripe": "^17.4.0",
    "twilio": "^5.7.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.27.4",
    "@babel/preset-env": "^7.27.2",
    "@babel/preset-react": "^7.27.1",
    "@vitejs/plugin-react": "^4.6.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/backend/tests/setup.js",
      "<rootDir>/backend/tests/setupModels.js"
    ],
    "collectCoverageFrom": [
      "backend/controllers/**/*.js",
      "backend/routes/**/*.js",
      "!**/node_modules/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!datebook)/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/frontend/"
    ]
  }
}
